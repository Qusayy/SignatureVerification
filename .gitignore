# Node
node_modules/
web/dist/
*.tsbuildinfo

# Data & models - NEVER commit. Signature images are biometric PII.
# `data/*` rather than `data/`: git does not descend into an excluded
# directory, so a `!data/.gitkeep` negation under `data/` would never apply and
# the placeholder would be silently dropped from the repository.
data/*
!data/.gitkeep
artifacts/*
!artifacts/.gitkeep
*.pt
*.pth
*.onnx
*.ckpt

# Generated reports - they embed corpus specifics and are rebuilt by the harness
docs/accuracy*.md
docs/accuracy*.json
docs/vendor-comparison*.md
docs/writer-count-ablation*.md
docs/writer-count-ablation*.json
docs/*.png

# Local env
.env
.env.local
*.log

