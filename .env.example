# Copy to .env and fill in. Never commit .env — it is git-ignored for a reason.
#
# Generate the two secrets:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Required in production -------------------------------------------------

# Encrypts every stored signature image. MUST be stable and backed up: lose it
# and every enrolled specimen becomes permanently unreadable. If unset, a
# throwaway key is generated per process and images do not survive a restart.
SV_IMAGE_ENCRYPTION_KEY=

# At least 32 bytes. HS256 with a shorter key is weaker than it looks.
SV_JWT_SECRET=

# --- Deployment -------------------------------------------------------------

# development | production. In production, startup misconfiguration warnings
# are logged as errors.
SV_ENVIRONMENT=development

# Defaults to SQLite in ./data. Use PostgreSQL for anything concurrent.
# SV_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/sigver

# Unset means encrypted files under ./data/storage. Set to use S3-compatible
# object storage instead.
# SV_STORAGE_ENDPOINT=http://localhost:9000
# SV_STORAGE_BUCKET=signatures
# SV_STORAGE_ACCESS_KEY=
# SV_STORAGE_SECRET_KEY=

# --- Model ------------------------------------------------------------------

# SV_CHECKPOINT_PATH=artifacts/signet_track_b.pt
# SV_COHORT_PATH=artifacts/cohort.npz
# SV_CALIBRATOR_PATH=artifacts/calibrator.json

# auto | cpu | cuda
SV_DEVICE=auto

# Refuse to start unless the loaded checkpoint passes the licence gate.
# Strongly recommended in production. See docs/licensing.md.
SV_REQUIRE_DEPLOYABLE_CHECKPOINT=false

# --- Air-gapped installs ----------------------------------------------------
# Foundation backbones download weights from the Hugging Face hub on first use.
# Pre-stage the cache on a connected machine, copy it over, then set:
# HF_HOME=/path/to/staged/cache
# HF_HUB_OFFLINE=1
